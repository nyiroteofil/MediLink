<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediLine_FrontEnd.Pages.AppointmentRequestDetailPage"
             BackgroundColor="#13131F"
             Title="Request Detail">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Appointment Request"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"/>

            <!-- Request details -->
            <Border BackgroundColor="#1E1E2E"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">
                <VerticalStackLayout Spacing="12">

                    <Label x:Name="PatientNameLabel"
                           Text="Patient: -"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="18"/>

                    <BoxView HeightRequest="1" Color="#333355"/>

                    <Label Text="Reason for visit:"
                           TextColor="#A0A0B0"
                           FontSize="12"/>
                    <Label x:Name="ReasonLabel"
                           Text="-"
                           TextColor="White"/>

                </VerticalStackLayout>
            </Border>

            <!-- Accept -->
            <Button Text="✅ Accept Request"
                    BackgroundColor="#44AA44"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="OnAcceptClicked"/>

            <!-- Deny -->
            <Border BackgroundColor="#1E1E2E"
                    StrokeShape="RoundRectangle 12"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Reason for denial (required if denying):"
                           TextColor="#A0A0B0"
                           FontSize="12"/>
                    <Editor x:Name="DenialReasonEntry"
                            Placeholder="Enter reason..."
                            PlaceholderColor="#606070"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            HeightRequest="80"/>
                    <Button Text="❌ Deny Request"
                            BackgroundColor="#FF4444"
                            TextColor="White"
                            CornerRadius="8"
                            Clicked="OnDenyClicked"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>