<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediLine_FrontEnd.Pages.ViewAppointmentsPage"
             BackgroundColor="#13131F"
             Title="My Appointments">

    <VerticalStackLayout Padding="30" Spacing="15">

        <Label Text="My Appointments"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="White"
               Margin="0,0,0,10"/>

        <CollectionView x:Name="AppointmentsCollection"
                        EmptyView="No appointments found.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1E1E2E"
                            StrokeShape="RoundRectangle 12"
                            Padding="15"
                            Margin="0,5">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
                            <Label Grid.Row="0"
                                   Text="{Binding PatientName, StringFormat='👤 Patient: {0}'}"
                                   TextColor="White"
                                   FontAttributes="Bold"/>
                            <Label Grid.Row="1"
                                   Text="{Binding DoctorName, StringFormat='🩺 Doctor: {0}'}"
                                   TextColor="#A0A0B0"/>
                            <Label Grid.Row="2"
                                   Text="{Binding ReasonOfRequest, StringFormat='📋 Reason: {0}'}"
                                   TextColor="#A0A0B0"/>
                            <Label Grid.Row="3"
                                   Text="{Binding Status, StringFormat='⚡ Status: {0}'}"
                                   TextColor="#6C63FF"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>