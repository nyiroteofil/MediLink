<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediLine_FrontEnd.Pages.AppointmentRequestsPage"
             BackgroundColor="#13131F"
             Title="Appointment Requests">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Pending Requests"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="White"/>

        <CollectionView x:Name="RequestsCollection"
                        EmptyView="No pending requests 🎉">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1E1E2E"
                            StrokeShape="RoundRectangle 12"
                            Padding="15" Margin="0,5">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding PatientName, StringFormat='👤 {0}'}"
                                   TextColor="White"
                                   FontAttributes="Bold"/>
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding ReasonOfRequest}"
                                   TextColor="#A0A0B0"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"/>
                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="Pending ⏳"
                                   TextColor="#6C63FF"
                                   FontSize="12"/>
                            <Button Grid.Row="0" Grid.Column="1"
                                    Grid.RowSpan="3"
                                    Text="View"
                                    BackgroundColor="#6C63FF"
                                    TextColor="White"
                                    CornerRadius="8"
                                    CommandParameter="{Binding ID}"
                                    Clicked="OnViewRequestClicked"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>