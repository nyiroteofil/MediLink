<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediLine_FrontEnd.Pages.DashboardPage"
             BackgroundColor="#13131F"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Greeting -->
            <Label x:Name="GreetingLabel"
                   Text="Good morning! 👋"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"/>

            <Label x:Name="RoleLabel"
                   Text=""
                   FontSize="14"
                   TextColor="#A0A0B0"/>

            <!-- Doctor widgets -->
            <Grid x:Name="DoctorWidgets"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="10"
                  IsVisible="False">

                <Border Grid.Column="0"
                        BackgroundColor="#1E1E2E"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="📋" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="PendingRequestsLabel"
                               Text="0"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#6C63FF"
                               HorizontalOptions="Center"/>
                        <Label Text="Pending Requests"
                               TextColor="#A0A0B0"
                               FontSize="11"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="#1E1E2E"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="📅" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="WeekAppointmentsLabel"
                               Text="0"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#6C63FF"
                               HorizontalOptions="Center"/>
                        <Label Text="This Week"
                               TextColor="#A0A0B0"
                               FontSize="11"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2"
                        BackgroundColor="#1E1E2E"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="👥" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="ActivePatientsLabel"
                               Text="0"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#6C63FF"
                               HorizontalOptions="Center"/>
                        <Label Text="Active Patients"
                               TextColor="#A0A0B0"
                               FontSize="11"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Patient widgets (hidden for now) -->
            <Grid x:Name="PatientWidgets"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  IsVisible="False">

                <Border Grid.Column="0"
                        BackgroundColor="#1E1E2E"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="📅" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="NextAppointmentLabel"
                               Text="-"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#6C63FF"
                               HorizontalOptions="Center"/>
                        <Label Text="Next Appointment"
                               TextColor="#A0A0B0"
                               FontSize="11"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="#1E1E2E"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="📋" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="ActiveRequestsLabel"
                               Text="0"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#6C63FF"
                               HorizontalOptions="Center"/>
                        <Label Text="Pending Requests"
                               TextColor="#A0A0B0"
                               FontSize="11"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Today's Events -->
            <Border BackgroundColor="#1E1E2E"
                    StrokeShape="RoundRectangle 12"
                    Padding="15">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Today's Events"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold"/>

                    <CollectionView x:Name="TodaysEventsCollection"
                                    EmptyView="No events today 🎉">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="80,*" 
                                      ColumnSpacing="10"
                                      Padding="0,8">
                                    <Label Grid.Column="0"
                                           Text="{Binding StartTime, StringFormat='{0:HH:mm}'}"
                                           TextColor="#6C63FF"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Description}"
                                           TextColor="White"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

            <!-- Next appointment banner -->
            <Border x:Name="NextAppointmentBanner"
                    BackgroundColor="#2D2B55"
                    StrokeShape="RoundRectangle 12"
                    Padding="15"
                    IsVisible="False">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="⏰" FontSize="24"/>
                    <VerticalStackLayout>
                        <Label Text="Next Appointment"
                               TextColor="#A0A0B0"
                               FontSize="12"/>
                        <Label x:Name="NextAppointmentBannerLabel"
                               Text="-"
                               TextColor="White"
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>