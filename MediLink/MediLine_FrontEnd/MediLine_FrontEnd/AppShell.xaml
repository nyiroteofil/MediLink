<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MediLine_FrontEnd.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:MediLine_FrontEnd.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="MediLink">

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#1E1E2E" Padding="20" HeightRequest="80">
            <Label Text="🏥 MediLink"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid BackgroundColor="#1E1E2E" Padding="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                   Text="{Binding FlyoutIcon}"
                   TextColor="#A0A0B0"
                   FontSize="18"
                   VerticalOptions="Center"/>
                <Label Grid.Column="1"
                   Text="{Binding Title}"
                   TextColor="#A0A0B0"
                   FontSize="15"
                   VerticalOptions="Center"/>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="Login"
        Shell.FlyoutItemIsVisible="False"/>

    <ShellContent
        Title="Dashboard"
        FlyoutIcon="📊"
        ContentTemplate="{DataTemplate pages:DashboardPage}"
        Route="main"/>

    <ShellContent
        x:Name="RegisterPatientContent"
        Title="Register Patient"
        FlyoutIcon="👤"
        ContentTemplate="{DataTemplate pages:RegisterPatientPage}"
        Route="register"/>

    <ShellContent
        x:Name="RequestAppointmentContent"
        Title="Request Appointment"
        FlyoutIcon="📅"
        ContentTemplate="{DataTemplate pages:RequestAppointmentPage}"
        Route="appointment"/>

    <ShellContent
        x:Name="ViewAppointmentsContent"
        Title="View Appointments"
        FlyoutIcon="📋"
        ContentTemplate="{DataTemplate pages:ViewAppointmentsPage}"
        Route="appointments"/>

    <ShellContent
    x:Name="AdminContent"
    Title="Admin Panel"
    FlyoutIcon="⚙️"
    ContentTemplate="{DataTemplate pages:AdminUserManagerPage}"
    Route="admin"/>

    <Shell.FlyoutFooter>
        <StackLayout BackgroundColor="#1E1E2E" Padding="15" Spacing="10">

            <Button Text="🚪 Logout"
                BackgroundColor="Transparent"
                TextColor="#A0A0B0"
                HorizontalOptions="Fill"
                Clicked="OnLogoutClicked"/>
        </StackLayout>
    </Shell.FlyoutFooter>

</Shell>